# Koneksi MariaDB. connection_limit=5 menahan pool Prisma agar hemat RAM di VPS 1GB.
# Dev lokal:
DATABASE_URL="mysql://root:root@localhost:3306/webcafe?connection_limit=5"
# Produksi: WAJIB user non-root.
# DATABASE_URL="mysql://webcafe:PASSWORD_KUAT@localhost:3306/webcafe?connection_limit=5"

# Rahasia JWT. Generate: openssl rand -hex 32
JWT_SECRET="ganti-dengan-64-hex-acak-jangan-pakai-nilai-ini"

PORT=3000
NODE_ENV=development

# Folder foto menu (relatif ke root repo)
UPLOAD_DIR="./uploads"

# Password admin saat seed. Kosongkan -> digenerate acak & dicetak sekali ke stdout.
SEED_ADMIN_PASSWORD=""
