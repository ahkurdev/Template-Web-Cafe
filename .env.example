# Database — pilih salah satu:
# SQLite default (spec WAJIB Drizzle, file lokal WAL):
# DATABASE_URL="file:./data/data.db"
# PostgreSQL (prod scale):
# DATABASE_URL="postgres://webcafe:***@localhost:5432/webcafe"
# MariaDB (implementasi saat ini Prisma — masih jalan):
DATABASE_URL="mysql://root:***@localhost:3306/webcafe?connection_limit=5"
# connection_limit=5 menahan pool Prisma agar hemat RAM di VPS 1GB (hanya untuk MySQL).

# Rahasia JWT. Generate: openssl rand -hex 32
JWT_SECRET="ganti-dengan-64-hex-acak-jangan-pakai-nilai-ini"

PORT=3000
NODE_ENV=development

# Folder foto menu (relatif ke root repo)
UPLOAD_DIR="./uploads"

# Password admin saat seed. Kosongkan -> digenerate acak & dicetak sekali ke stdout.
SEED_ADMIN_PASSWORD=""
